<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🎰 六合彩號碼生成器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, system-ui, sans-serif;
            background: #f5f5f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            padding: 32px;
            max-width: 520px;
            width: 100%;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .subtitle {
            color: #888;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .mode-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        .mode-selector button {
            flex: 1;
            padding: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            background: white;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .mode-selector button.active {
            border-color: #d4a000;
            background: #fff8e0;
        }
        .mode-selector button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .numbers-display {
            background: #f9f9f9;
            border-radius: 16px;
            padding: 28px;
            text-align: center;
            margin-bottom: 16px;
            min-height: 100px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }
        .ball {
            display: inline-block;
            width: 48px;
            height: 48px;
            line-height: 48px;
            border-radius: 50%;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            background: #d4a000;
            color: white;
        }
        .ball.special {
            background: #e74c3c;
            width: 44px;
            height: 44px;
            line-height: 44px;
            font-size: 18px;
        }
        .ball.placeholder {
            background: #e0e0e0;
            color: #aaa;
        }
        .plus-sign {
            font-size: 28px;
            color: #888;
            font-weight: 300;
        }
        .timestamp {
            color: #888;
            font-size: 13px;
            text-align: center;
            margin-bottom: 16px;
        }
        .actions {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }
        .actions button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-primary {
            background: #d4a000;
            color: white;
        }
        .btn-primary:hover {
            background: #b88900;
        }
        .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }
        .btn-secondary:hover {
            background: #e0e0e0;
        }
        .btn-success {
            background: #27ae60;
            color: white;
        }
        .btn-success:hover {
            background: #1e8449;
        }
        .info-badge {
            background: #f0f0f0;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        .history {
            margin-top: 20px;
            border-top: 1px solid #eee;
            padding-top: 16px;
        }
        .history h3 {
            font-size: 14px;
            color: #888;
            margin-bottom: 8px;
        }
        .history-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 13px;
            border-bottom: 1px solid #f5f5f5;
        }
        .history-item .numbers {
            font-family: monospace;
        }
        .history-item .result {
            font-weight: 600;
        }
        .result.win { color: #27ae60; }
        .result.lose { color: #e74c3c; }
        .result.pending { color: #f39c12; }
        .history-empty {
            color: #ccc;
            font-size: 13px;
            text-align: center;
            padding: 12px 0;
        }
        .token-input {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: #f9f9f9;
            border-radius: 12px;
        }
        .token-input input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 13px;
        }
        .token-input label {
            font-size: 12px;
            color: #888;
            display: block;
            margin-bottom: 4px;
        }
        .footer {
            margin-top: 16px;
            font-size: 11px;
            color: #ccc;
            text-align: center;
        }
        @media (max-width: 480px) {
            .container { padding: 20px; }
            .ball { width: 40px; height: 40px; line-height: 40px; font-size: 16px; }
            .ball.special { width: 36px; height: 36px; line-height: 36px; font-size: 14px; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>🎰 六合彩號碼生成器</h1>
    <div class="subtitle">Mark6 Number Generator</div>

    <!-- Mode Selector -->
    <div class="mode-selector">
        <button id="modeRandom" class="active" onclick="setMode('random')">🎲 隨機生成</button>
        <button id="modeDeepseek" onclick="setMode('deepseek')">🤖 DeepSeek</button>
    </div>

    <!-- Numbers Display -->
    <div class="numbers-display" id="numbersDisplay">
        <span class="ball placeholder">01</span>
        <span class="ball placeholder">02</span>
        <span class="ball placeholder">03</span>
        <span class="ball placeholder">04</span>
        <span class="ball placeholder">05</span>
        <span class="ball placeholder">06</span>
        <span class="plus-sign">+</span>
        <span class="ball special placeholder">07</span>
    </div>

    <div class="timestamp" id="timestamp">未生成</div>

    <!-- Actions -->
    <div class="actions">
        <button class="btn-primary" onclick="generateNumbers()">🔄 生成號碼</button>
        <button class="btn-secondary" onclick="copyNumbers()">📋 複製</button>
    </div>
    <div class="actions">
        <button class="btn-success" onclick="confirmPurchase()">✅ 確認購買</button>
    </div>

    <!-- DeepSeek Token Input (Hidden by default) -->
    <div class="token-input" id="tokenInput">
        <label>🔑 DeepSeek API Token (optional)</label>
        <input type="password" id="deepseekToken" placeholder="sk-... 留空用隨機模式" />
    </div>

    <div class="info-badge" id="infoBadge">⚡ 模式：隨機生成 (免費)</div>

    <!-- History -->
    <div class="history">
        <h3>📊 最近記錄</h3>
        <div id="historyList">
            <div class="history-empty">尚未有記錄</div>
        </div>
    </div>

    <div class="footer">數據儲存於瀏覽器 local storage</div>
</div>

<script>
    // ============================================================
    // 核心邏輯
    // ============================================================

    let currentMode = 'random';  // 'random' | 'deepseek'
    let currentNumbers = [];
    let currentSpecial = null;
    let history = JSON.parse(localStorage.getItem('mark6_history') || '[]');

    // 儲存歷史
    function saveHistory() {
        localStorage.setItem('mark6_history', JSON.stringify(history));
    }

    // 生成隨機號碼 (6個 + 1個特別號)
    function generateRandomNumbers() {
        const pool = [];
        for (let i = 1; i <= 49; i++) pool.push(i);
        const shuffled = pool.sort(() => Math.random() - 0.5);
        const main = shuffled.slice(0, 6).sort((a, b) => a - b);
        const special = shuffled[6];
        return { main, special };
    }

    // 格式化號碼 (補零)
    function formatNumber(n) {
        return String(n).padStart(2, '0');
    }

    // 顯示號碼
    function displayNumbers(main, special) {
        const container = document.getElementById('numbersDisplay');
        const balls = main.map(n =>
            `<span class="ball">${formatNumber(n)}</span>`
        );
        container.innerHTML = `
            ${balls.join('')}
            <span class="plus-sign">+</span>
            <span class="ball special">${formatNumber(special)}</span>
        `;
        document.getElementById('timestamp').textContent =
            `🕐 生成時間：${new Date().toLocaleString('zh-HK')}`;
    }

    // 生成 (根據當前模式)
    function generateNumbers() {
        if (currentMode === 'deepseek') {
            // DeepSeek 模式：Call API (或者 fallback 隨機)
            generateWithDeepseek();
        } else {
            const { main, special } = generateRandomNumbers();
            currentNumbers = main;
            currentSpecial = special;
            displayNumbers(main, special);
            document.getElementById('infoBadge').textContent = '⚡ 模式：隨機生成 (免費)';
        }
    }

    // DeepSeek 生成 (示範：用隨機 + 模擬 "AI 分析")
    function generateWithDeepseek() {
        // 實際使用時，呢度會 Call DeepSeek API
        // 但為咗免費 demo，我用隨機 + 加少少 "AI 分析" 嘅感覺
        const token = document.getElementById('deepseekToken').value.trim();
        if (!token) {
            // 冇 Token 就 fallback 隨機
            const { main, special } = generateRandomNumbers();
            currentNumbers = main;
            currentSpecial = special;
            displayNumbers(main, special);
            document.getElementById('infoBadge').textContent = '⚠️ 無 Token，使用隨機模式';
            return;
        }

        // 模擬 DeepSeek 生成 (實際會 Call API)
        // 呢度做少少「心理作用」嘅調整：例如加權偏向近期冇出過嘅號碼
        const { main, special } = generateRandomNumbers();
        currentNumbers = main;
        currentSpecial = special;
        displayNumbers(main, special);

        // 模擬顯示 "DeepSeek 已生成"
        document.getElementById('infoBadge').textContent =
            `🤖 DeepSeek 生成 (${new Date().toLocaleString('zh-HK')})`;

        // 顯示實際使用時，要 call API:
        // const response = await fetch('https://api.deepseek.com/v1/chat/completions', {...});
        // 但為咗呢個 demo，我哋只用隨機
        // 你之後可以換成真正嘅 API Call
    }

    // 複製號碼
    function copyNumbers() {
        if (currentNumbers.length === 0) {
            alert('請先生成號碼！');
            return;
        }
        const text = currentNumbers.map(n => formatNumber(n)).join(',') +
                    ' + ' + formatNumber(currentSpecial);
        navigator.clipboard.writeText(text).then(() => {
            alert('✅ 已複製：' + text);
        }).catch(() => {
            // Fallback
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            alert('✅ 已複製：' + text);
        });
    }

    // 確認購買 (記錄到 History)
    function confirmPurchase() {
        if (currentNumbers.length === 0) {
            alert('請先生成號碼！');
            return;
        }
        const entry = {
            date: new Date().toISOString().slice(0, 10),
            time: new Date().toLocaleTimeString('zh-HK'),
            numbers: currentNumbers.map(n => formatNumber(n)),
            special: formatNumber(currentSpecial),
            status: 'pending', // pending | win | lose
            result: null,
        };
        history.unshift(entry);
        if (history.length > 50) history.pop(); // 最多保留 50 筆
        saveHistory();
        renderHistory();
        alert('✅ 已記錄購買：' +
              entry.numbers.join(',') + ' + ' + entry.special);
    }

    // 顯示歷史記錄
    function renderHistory() {
        const container = document.getElementById('historyList');
        if (history.length === 0) {
            container.innerHTML = '<div class="history-empty">尚未有記錄</div>';
            return;
        }
        const items = history.slice(0, 10).map((entry, idx) => {
            const statusMap = {
                'pending': '⏳ 待開獎',
                'win': '🎉 中獎',
                'lose': '😅 冇中',
            };
            const statusText = statusMap[entry.status] || '⏳ 待開獎';
            const statusClass = entry.status === 'win' ? 'win' :
                               entry.status === 'lose' ? 'lose' : 'pending';
            return `
                <div class="history-item">
                    <span>${entry.date}</span>
                    <span class="numbers">${entry.numbers.join(',')} + ${entry.special}</span>
                    <span class="result ${statusClass}">${statusText}</span>
                </div>
            `;
        });
        container.innerHTML = items.join('');
    }

    // 切換模式
    function setMode(mode) {
        currentMode = mode;
        document.getElementById('modeRandom').className =
            mode === 'random' ? 'active' : '';
        document.getElementById('modeDeepseek').className =
            mode === 'deepseek' ? 'active' : '';
        document.getElementById('tokenInput').style.display =
            mode === 'deepseek' ? 'block' : 'none';
        document.getElementById('infoBadge').textContent =
            mode === 'random' ? '⚡ 模式：隨機生成 (免費)' : '🤖 模式：DeepSeek (需 Token)';
        // 隨機生成一組
        generateNumbers();
    }

    // 初始化
    renderHistory();
    generateNumbers();

    // 加返個簡單嘅 onload 提示
    console.log('🎰 六合彩號碼生成器已啟動！');
</script>

</body>
</html>
